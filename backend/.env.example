APP_NAME=Educity
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DB_CONNECTION=pgsql
DB_SCHEMA=educity
DB_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=educity
DB_USERNAME=root
DB_PASSWORD=

FILESYSTEM_DISK=public
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database
LOG_CHANNEL=stderr

# Keep "public" for local development. Render must use "cloudinary" because
# its filesystem is ephemeral; set the three Cloudinary credentials there.
MEDIA_DRIVER=public
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# TiDB Cloud uses MySQL with TLS. Supply its CA file path when required.
DB_SSLMODE=prefer
MYSQL_ATTR_SSL_CA=

MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
ADMIN_NOTIFICATION_EMAIL=

ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
